# Dependencias y builds
node_modules
*.tsbuildinfo
/local-*

# Salidas de test y cobertura
coverage/
playwright-report/
test-results/

# Credenciales. La entrada mas importante del archivo: se queda aunque hoy no exista
# ningun .env, que es justamente el punto.
.env*
*.pem

# Herramientas y editores
.DS_Store
.vscode/
.vercel
.claude/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Paquetes del monorepo: dist/ y node_modules ───────────────────────────
reporter-core/dist
reporter-core/node_modules
test-runner/dist
test-runner/node_modules
test-runner/tests/test-results
cypress-plugin/dist
cypress-plugin/node_modules
cypress-plugin/tests/cypress/screenshots
cypress-plugin/tests/cypress/videos
cli/dist
cli/node_modules
selenium-plugin/dist
selenium-plugin/node_modules
ai-local/dist
ai-local/node_modules
webdriverio-plugin/dist
mcp/dist
webdriverio-plugin/node_modules

# Copias del LICENSE de la raiz que genera scripts/sync-license.mjs en cada `prepack`.
# npm solo mete el LICENSE en el tarball si esta en la raiz DEL PAQUETE, pero versionar 7
# copias del mismo texto es pedirles que diverjan. El original es uno solo; estas son
# derivadas, y CI verifica que efectivamente lleguen al tarball.
reporter-core/LICENSE
test-runner/LICENSE
cypress-plugin/LICENSE
selenium-plugin/LICENSE
webdriverio-plugin/LICENSE
ai-local/LICENSE
cli/LICENSE
mcp/LICENSE

# ─── Extension de VS Code ──────────────────────────────────────────────────
vscode-extension/node_modules
vscode-extension/dist
vscode-extension/out
vscode-extension/.vscode-test
vscode-extension/*.vsix
vscode-extension/LICENSE

# ─── Adapters de otros lenguajes: artefactos de build ──────────────────────
python/healify-selenium/dist/
python/healify-selenium/build/
python/healify-selenium/src/*.egg-info/
__pycache__/
*.pyc
java/healify-selenium/target/

# ─── Ejemplos: artefactos de corrida, no fuente ────────────────────────────
examples/*/node_modules
examples/*/test-results
examples/*/healify-report.*
examples/*/healify-audit.*
examples/*/.healify/

# Historial local de Healify corriendo contra si mismo (dev/testing manual) — no es
# contenido del proyecto, mismo criterio que recomendamos a los usuarios en cli/README.md.
.healify/

# Notas internas: utiles en local, ruido en un repo publico.
PARA-MANANA.md
