{
  "name": "@healify/cypress-plugin",
  "version": "2.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mescobar996/Healify.git",
    "directory": "cypress-plugin"
  },
  "homepage": "https://healify-sigma.vercel.app",
  "bugs": {
    "url": "https://github.com/mescobar996/Healify/issues"
  },
  "description": "Healify reporter for Cypress: reports broken selectors without requiring GitHub repo access.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../scripts/sync-license.mjs",
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --outdir=dist --format=cjs --external:cypress && esbuild src/support.ts --bundle --platform=browser --outfile=dist/support.js --format=cjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "cypress": "^15.19.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
