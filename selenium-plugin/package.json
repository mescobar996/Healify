{
  "name": "@healify/selenium-plugin",
  "version": "2.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mescobar996/Healify.git",
    "directory": "selenium-plugin"
  },
  "homepage": "https://healify-sigma.vercel.app",
  "bugs": {
    "url": "https://github.com/mescobar996/Healify/issues"
  },
  "description": "Self-healing wrapper for Selenium WebDriver: heuristic, local-first, no AI, no server.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --outdir=dist --format=cjs --external:selenium-webdriver",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "selenium-webdriver": "^4.0.0"
  },
  "devDependencies": {
    "@healify/reporter-core": "*",
    "@types/selenium-webdriver": "^4.35.6",
    "esbuild": "^0.28.1",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
