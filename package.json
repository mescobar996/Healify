{
  "name": "healify",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "reporter-core",
    "test-runner",
    "cypress-plugin",
    "cli",
    "selenium-plugin",
    "webdriverio-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "verify": "bash scripts/verify.sh",
    "verify:win": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "coverage": "bash scripts/coverage.sh",
    "coverage:win": "powershell -ExecutionPolicy Bypass -File scripts/coverage.ps1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10"
  }
}
