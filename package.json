{
  "name": "healify",
  "version": "0.2.0",
  "private": true,
  "_comment_workspaces": "El orden importa: `npm run build --workspaces` respeta este array y NO ordena por dependencias. `cli` importa @healify/ai-local y @healify/reporter-core, asi que va ultimo; con `cli` antes de `ai-local` (el orden anterior) un build desde cero fallaba con TS2307.",
  "workspaces": [
    "reporter-core",
    "ai-local",
    "test-runner",
    "cypress-plugin",
    "selenium-plugin",
    "webdriverio-plugin",
    "mcp",
    "cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "verify": "bash scripts/verify.sh",
    "verify:win": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "coverage": "bash scripts/coverage.sh",
    "coverage:win": "powershell -ExecutionPolicy Bypass -File scripts/coverage.ps1",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  }
}
