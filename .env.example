# ============================================
# HEALIFY — Environment Variables Example
# Copy this to .env.local and fill in values
# NEVER commit .env.local to git
# ============================================

# El modo local (@healify/test-runner y @healify/cypress-plugin sin
# HEALIFY_API_KEY seteada) no necesita NINGUNA variable de entorno.
# Lo de abajo solo aplica si vas a levantar este servidor Next.js
# como endpoint de modo nube opcional (/api/v1/report).

# ── API key compartida para /api/v1/report (opcional) ────────────
# El cliente manda este mismo valor en el header x-api-key.
# Sin esta variable seteada, el endpoint devuelve 401 a todo.
HEALIFY_API_KEY=

# ── Public URL (opcional, usada en metadata/OG) ───────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
